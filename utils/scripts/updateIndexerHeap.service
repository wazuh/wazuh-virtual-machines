[Unit]
Description=Update Wazuh Indexer jvm.option memory heap space
# Runs once, on the first boot of the deployed image: the script disables the unit when it is done,
# so a heap changed later in jvm.options is kept across reboots.
Before=wazuh-indexer.service wazuh-ami-customizer.service wazuh-starter.service

[Install]
WantedBy=multi-user.target

[Service]
Type=oneshot
ExecStart=/bin/bash /etc/automatic_set_ram.sh
