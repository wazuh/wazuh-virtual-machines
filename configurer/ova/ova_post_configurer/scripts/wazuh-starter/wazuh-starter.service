[Unit]
Description=Starts Wazuh services in order
Wants=wazuh-starter.timer network-online.target
# The packages issue their certificates with the addresses they find when the starter runs.
After=network-online.target

[Service]
Type=oneshot
ExecStart=/etc/.wazuh-starter.sh

[Install]
WantedBy=multi-user.target
